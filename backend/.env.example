# Banco de dados
DATABASE_URL="postgresql://myscreen_tv_app:CHANGE_ME@localhost:5432/myscreen_tv?schema=public"

# JWT
JWT_SECRET="troque-por-segredo-longo-e-aleatorio-minimo-64-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="outro-segredo-longo-e-aleatorio-diferente-do-access"
JWT_REFRESH_EXPIRATION="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

# TMDB
TMDB_API_KEY="sua_chave_aqui"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# App
PORT=3001
NODE_ENV=development

# Sysadmin seed
SYSADMIN_EMAIL="admin@myscreen.tv"
SYSADMIN_PASSWORD="Admin@123456!"
SYSADMIN_USERNAME="sysadmin"
SYSADMIN_DISPLAY_NAME="Administrador"

# E-mail (Resend)
RESEND_API_KEY="re_sua_chave_aqui"
MAIL_FROM="no-reply@seudominio.com"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_USERNAME=            # opcional — usuário ACL do Redis
REDIS_PASSWORD="TROQUE_PELA_MESMA_SENHA_DO_DOCKER_COMPOSE"
REDIS_DB=0
REDIS_TLS=false              # defina true em staging/produção com TLS

# Fila de e-mails
EMAIL_QUEUE_CONCURRENCY=5    # máximo de jobs processados em paralelo por instância

# Bull Board — painel de inspeção de filas (desabilitado por padrão)
ENABLE_BULL_BOARD=false
# BULL_BOARD_USER=           # obrigatório quando ENABLE_BULL_BOARD=true
# BULL_BOARD_PASSWORD=       # obrigatório quando ENABLE_BULL_BOARD=true
